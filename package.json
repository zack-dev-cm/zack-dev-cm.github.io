{
  "name": "zakhar-pashkin-ai-computer-vision-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "stats:clawhub": "node scripts/fetch-clawhub-stats.mjs",
    "sync:github": "node scripts/sync-github-portfolio-updates.mjs",
    "sync:github:verify": "node scripts/sync-github-portfolio-updates.mjs --verify",
    "review:clawpatch": "node scripts/run-clawpatch-review.mjs",
    "review:github": "npm run sync:github:verify && npm run validate && npm run security:gate && npm run audit:codex",
    "validate": "node scripts/validate-portfolio.mjs",
    "validate:seo-aeo": "node scripts/validate-seo-aeo.mjs",
    "typecheck": "tsc --noEmit",
    "security:gate": "node scripts/security-gate.mjs",
    "audit:codex": "node scripts/run-codex-audit.mjs",
    "prebuild": "npm run typecheck && node scripts/generate-project-markdown.mjs && node scripts/validate-portfolio.mjs",
    "build": "vite build",
    "postbuild": "node scripts/postbuild.mjs && node scripts/security-gate.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.14.0",
    "pdf-parse": "^2.4.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
